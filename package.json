{
  "name": "knox-workspace",
  "version": "1.2.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir ui dev",
    "prebuild": "powershell -Command \"Get-Process knox-desktop,knox -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; exit 0\"",
    "build:ui": "pnpm --dir ui build",
    "build:portable": "tauri build --no-bundle",
    "build": "tauri build --bundles nsis",
    "test": "cargo test --workspace",
    "typecheck": "pnpm --dir ui typecheck",
    "lint": "cargo clippy --workspace --all-targets",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}

